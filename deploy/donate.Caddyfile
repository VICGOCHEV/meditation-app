# ── Страница добровольного доната: блок для вставки в site-блок all-relaxme.ru
# Вставлять ВНУТРЬ существующего `all-relaxme.ru { ... }`, рядом с блоками из
# cms.Caddyfile и ВЫШЕ общего fallback-а статики фронта.
#
# Статика лежит прямо в репозитории (`donate/`), сборка не нужна — один
# index.html без зависимостей. На проде это /opt/meditation-app/donate.
#
# Зачем отдельная страница вместо экрана в приложении: правила ВК
# (письмо модерации 30.07.2026, п. 5.4.1/5.4.2 mini-apps-rules) запрещают
# на клиентах iOS/Android любую оплату и любые уводы к оплате, включая
# текстовые. Поэтому донат вынесен за пределы Mini App, а внутри VK кнопка
# на эту страницу не показывается вовсе (application/src/lib/donate.js).
#
# Платёж создаётся через POST /api/donate/create — он уже проксируется
# существующим правилом для /api, отдельный proxy не нужен.

handle_path /donate/* {
    root * /opt/meditation-app/donate
    try_files {path} /index.html
    file_server
}

# Без хвостового слэша — чтобы /donate тоже открывался.
redir /donate /donate/ permanent
